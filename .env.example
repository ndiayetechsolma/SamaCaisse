# SamaCaisse
# Variables à renseigner dans Vercel : Settings > Environment Variables.
# Elles ne sont utilisées QUE par les routes serveur /api/* — jamais envoyées au navigateur.

# URL de ton projet Supabase (https://ton-projet.supabase.co)
SUPABASE_URL=https://ton-projet.supabase.co

# Clé SECRÈTE service_role. À ne JAMAIS exposer côté client ni committer.
SUPABASE_SERVICE_ROLE_KEY=ta-cle-secrete-service-role

# Secret utilisé pour signer les sessions (JWT) des propriétaires et du personnel.
PERSONNEL_SESSION_SECRET=une-chaine-longue-aleatoire-et-secrete